stars_lite.bin
galaxies_all_points.csv
galaxies_all.bin
gaia_points_main.csv

# Source catalogues and packed binaries are regenerable and far past what GitHub will
# accept — gaia_points_5m.csv alone is 379 MB against a 100 MB hard limit, which is what
# blocked the push. Rebuild them with fetch_*.py + to_bin.py + pack_octree.py.
*.csv
*.bin
!filaments.bin
gaia_points.csv.*
